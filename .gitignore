<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Turismo no Espírito Santo</title>
<style>
body { font-family: Arial, sans-serif; background: #ffffff; color: #222; margin: 0; text-align: center; }
h2, h3 { color: #1f5c38; }
#login { max-width: 300px; margin: 60px auto; background: white; border: 2px solid #2e7d4f; padding: 20px; border-radius: 8px; }
input, button { width: 100%; padding: 10px; margin: 6px 0; box-sizing: border-box; font-size: 1rem; }
button { background: #2e7d4f; color: white; border: none; border-radius: 4px; cursor: pointer; }
#principal { display: none; padding: 10px; }
svg { width: 100%; max-width: 400px; background: #f4f9f5; border: 2px solid #2e7d4f; }
.vizinho { fill: #e6ebe7; stroke: #8a9a8f; }
.es { fill: #2e7d4f; stroke: #1f5c38; stroke-width: 2; }
circle { fill: white; stroke: #1f5c38; stroke-width: 2; cursor: pointer; }
#info { background: white; border: 2px solid #2e7d4f; max-width: 400px; margin: 10px auto; padding: 10px; border-radius: 8px; }
#lista button { width: auto; margin: 3px; padding: 6px 10px; font-size: .85rem; }
</style>
</head>
<body>

<!-- Tela de login -->
<div id="login">
  <h2>Espírito Santo</h2>
  <p>Entre para ver o mapa</p>
  <input id="usuario" placeholder="Usuário">
  <input id="senha" type="password" placeholder="Senha">
  <button onclick="entrar()">Entrar</button>
  <button onclick="cadastrar()">Cadastrar</button>
  <p id="erro" style="color:red"></p>
</div>

<!-- Tela do mapa -->
<div id="principal">
  <h2>Pontos turísticos do ES</h2>
  <p>Olá, <span id="nome"></span> | <a href="#" onclick="sair()">Sair</a></p>
  <svg id="mapa" viewBox="-120 -90 680 820"></svg>
  <div id="info">Clique em um ponto do mapa.</div>
  <div id="lista"></div>
</div>

<script>
// Lugares: nome, longitude, latitude e descrição
var lugares = [
  ["Itaúnas", -39.70, -18.41, "Vila com dunas e muito forró."],
  ["Regência", -39.82, -19.65, "Praia boa para surfe, na foz do rio Doce."],
  ["Santa Teresa", -40.60, -19.94, "Primeira colônia italiana do Brasil."],
  ["Convento da Penha", -40.29, -20.33, "Santuário no alto do morro, em Vila Velha."],
  ["Vitória", -40.34, -20.31, "Capital do estado, famosa pela moqueca."],
  ["Pedra Azul", -41.00, -20.40, "Pedra de granito enorme na região serrana."],
  ["Guarapari", -40.50, -20.67, "Cidade de praias e areia monazítica."],
  ["Anchieta", -40.65, -20.80, "Cidade do padre Anchieta."],
  ["Caparaó", -41.83, -20.43, "Parque com o Pico da Bandeira."]
];

// Contorno da costa do ES (longitude, latitude)
var costa = [[-39.69,-18.09],[-39.73,-18.6],[-39.78,-19.35],[-39.82,-19.63],
  [-40.12,-19.96],[-40.29,-20.33],[-40.49,-20.67],[-40.83,-21.04],[-41.03,-21.30]];
// Divisa do ES com outros estados
var divisa = [[-41.55,-21.22],[-41.87,-20.9],[-41.88,-20.52],[-41.5,-20.12],
  [-41.18,-19.75],[-41.05,-19.2],[-40.95,-18.78],[-40.95,-18.35],[-40.65,-17.93],[-39.95,-18.03]];

// Converte longitude/latitude em posição na tela
function xy(lon, lat) {
  return [(lon + 42) * 190, (-17.9 - lat) * 190];
}

// Transforma uma lista de coordenadas em texto para o polygon
function pontos(lista) {
  var texto = "";
  for (var i = 0; i < lista.length; i++) {
    var p = xy(lista[i][0], lista[i][1]);
    texto += p[0] + "," + p[1] + " ";
  }
  return texto;
}

// ---------- LOGIN ----------
function cadastrar() {
  var u = document.getElementById("usuario").value;
  var s = document.getElementById("senha").value;
  if (u == "" || s.length < 4) {
    document.getElementById("erro").innerHTML = "Digite usuário e senha (mínimo 4 letras).";
    return;
  }
  localStorage.setItem("user_" + u, s);
  document.getElementById("erro").innerHTML = "Cadastrado! Agora clique em Entrar.";
}

function entrar() {
  var u = document.getElementById("usuario").value;
  var s = document.getElementById("senha").value;
  if (localStorage.getItem("user_" + u) == s && s != "") {
    document.getElementById("login").style.display = "none";
    document.getElementById("principal").style.display = "block";
    document.getElementById("nome").innerHTML = u;
    desenhar();
  } else {
    document.getElementById("erro").innerHTML = "Usuário ou senha errados.";
  }
}

function sair() {
  location.reload();
}

// ---------- MAPA ----------
function desenhar() {
  var brasil = [[-43,-17],[-39.18,-17.2],[-39.37,-17.89]].concat(costa, [[-41,-21.9],[-43,-21.9]]);
  var es = costa.concat(divisa);

  var svg = '<polygon class="vizinho" points="' + pontos(brasil) + '"/>';
  svg += '<polygon class="es" points="' + pontos(es) + '"/>';
  svg += '<text x="-90" y="300" font-size="20">Minas Gerais</text>';
  svg += '<text x="150" y="-40" font-size="20">Bahia</text>';
  svg += '<text x="-60" y="690" font-size="20">Rio de Janeiro</text>';

  var botoes = "";
  for (var i = 0; i < lugares.length; i++) {
    var p = xy(lugares[i][1], lugares[i][2]);
    svg += '<circle cx="' + p[0] + '" cy="' + p[1] + '" r="9" onclick="mostrar(' + i + ')"/>';
    botoes += '<button onclick="mostrar(' + i + ')">' + lugares[i][0] + '</button>';
  }
  document.getElementById("mapa").innerHTML = svg;
  document.getElementById("lista").innerHTML = botoes;
}

function mostrar(i) {
  document.getElementById("info").innerHTML =
    "<h3>" + lugares[i][0] + "</h3><p>" + lugares[i][3] + "</p>";
}
</script>
</body>
</html>
